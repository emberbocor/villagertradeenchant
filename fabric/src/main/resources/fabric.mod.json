{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Adds an Enchanter villager that enchants your items for a configurable price.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/villagertradeenchant",
    "sources": "https://github.com/emberbocor/villagertradeenchant",
    "issues": "https://github.com/emberbocor/villagertradeenchant/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.emberbocor.villagertradeenchant.VillagerTradeEnchantFabric"
    ],
    "client": [
      "io.github.emberbocor.villagertradeenchant.VillagerTradeEnchantFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  },
  "breaks": {
    "villager_enchanter": "*"
  }
}
